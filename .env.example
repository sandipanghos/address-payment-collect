# Razorpay API keys — Dashboard > Account & Settings > API Keys
# Use rzp_test_* keys in development. NEVER commit the real .env.local.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# The key id is also needed in the browser to open Checkout.
# Only the KEY_ID is public-safe. The SECRET must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Webhook secret — Dashboard > Settings > Webhooks > create webhook.
# This is a value YOU choose when creating the webhook; it is not the API secret.
RAZORPAY_WEBHOOK_SECRET=some-long-random-string

# Subscribe the webhook to these events:
#   payment.captured, payment.failed, order.paid, refund.processed
